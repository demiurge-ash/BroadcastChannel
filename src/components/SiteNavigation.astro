---
import type { NavItem } from '../types'
import SearchForm from './SearchForm.astro'

const {
  channelTitle,
  currentPathname,
  googleSearchSite,
  linksPathname,
  navs = [],
  searchAction,
  showLinks,
  showTags,
  siteUrl,
  tagsPathname,
  telegramChannel,
} = Astro.props as {
  channelTitle?: string
  currentPathname: string
  googleSearchSite?: string
  linksPathname: string
  navs?: NavItem[]
  searchAction: string
  showLinks?: boolean
  showTags?: boolean
  siteUrl: string
  tagsPathname: string
  telegramChannel?: string
}

const primaryNavItems = [
  showTags && {
    href: `${siteUrl}tags`,
    pathname: tagsPathname,
    title: 'Tags',
  },
  showLinks && {
    href: `${siteUrl}links`,
    pathname: linksPathname,
    title: 'Links',
  },
].filter((item): item is { href: string; pathname: string; title: string } => Boolean(item))
---

<nav class="site-navigation" aria-label="Primary navigation">
  <ul>
    {
      telegramChannel && (
        <li>
          <a class="telegram-link" href={`https://t.me/${telegramChannel}`} title={channelTitle} target="_blank">
            Telegram
          </a>
        </li>
      )
    }
    {
      primaryNavItems.map((nav) => (
        <li>
          <a href={nav.href} title={nav.title} aria-current={currentPathname === nav.pathname ? 'page' : undefined}>
            {nav.title}
          </a>
        </li>
      ))
    }
    {
      navs.map((nav) => (
        <li>
          <a href={nav.href} title={nav.title} target="_blank" rel="noopener noreferrer">
            {nav.title}
          </a>
        </li>
      ))
    }
  </ul>
  <SearchForm action={searchAction} googleSearchSite={googleSearchSite} />
</nav>
